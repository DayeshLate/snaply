# Database (PostgreSQL / Supabase)
PGHOST=aws-1-ap-south-1.pooler.supabase.com
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=your_password
PG_SSLMODE=require

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# SMTP (Google / Mailtrap)
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Authentication & CORS
JWT_SECRET=your_jwt_secret_key
AUTH_DEV_LOGIN_ENABLED=true
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

# Google Drive Integration
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ==========================================
# AI Vision & Semantic Search Configuration
# ==========================================
# You only need ONE of these keys (Gemini is recommended):
GEMINI_API_KEY=AIzaSy...your_gemini_api_key_here
# or
# OPENAI_API_KEY=sk-...your_openai_api_key_here

# Optional AI Overrides (defaults shown):
AI_PROVIDER=gemini
GEMINI_VISION_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
# OPENAI_VISION_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_BATCH_SIZE=10
AI_MAX_RETRIES=3
AI_MIN_SIMILARITY=0.25
AI_AUTO_INDEX_ENABLED=true

